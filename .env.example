# integration-service-framework — example environment configuration.
# Copy to .env and adjust. Services subclassing FrameworkSettings add their
# own variables on top of these (see README.md for the full reference).

# Identity
SERVICE_NAME=Echo Integration Service
# serviceType this instance handles; messages with a different serviceType are ignored.
SERVICE_TYPE=echo_service

# RabbitMQ connection
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# RABBITMQ_USERNAME is accepted as an alias for RABBITMQ_USER.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=600
RABBITMQ_CONNECTION_TIMEOUT=10

# Request/response pipeline: requests are fanned out from the request exchange
# to a per-service queue; response envelopes go to the response topic.
RABBITMQ_REQUEST_TOPIC=requests
RABBITMQ_REQUEST_QUEUE=requests.echo
RABBITMQ_RESPONSE_TOPIC=responses

CONSUMER_PREFETCH_COUNT=10

# Initial-connect retry loop (0 attempts = retry forever); once connected,
# aio-pika RobustConnection handles reconnects automatically.
RABBITMQ_MAX_RETRY_ATTEMPTS=0
RABBITMQ_INITIAL_RETRY_DELAY=1
RABBITMQ_MAX_RETRY_DELAY=60
RABBITMQ_RETRY_BACKOFF_MULTIPLIER=2

# HTTP server
HTTP_PORT=8080

# Logging (LOG_FILE empty = console only)
LOG_LEVEL=INFO
LOG_FILE=
LOG_RETENTION_DAYS=7

# Best-effort integration audit. The pool opens on first use and retries lazily.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_POOL_MAX=15
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_RECONNECT_INTERVAL=60
SERVICE_USER_ID=1

# 'development' enables the /debug endpoints. Never set in production.
APP_ENV=development
